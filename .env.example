# Copy to .env.local (local) and set in the hosting platform (Railway/Vercel).
# Never commit real secrets.

# Auth: doubles as the shared login password AND HMAC signing key for the
# session cookie. Rotating it invalidates all active sessions.
SECRET_KEY=

# LLM providers (server-side only — never exposed to the browser)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GPT_API_KEY=
# OPENAI_API_KEY is also supported as a fallback alias for GPT_API_KEY.
# OPENAI_API_KEY=

# Vercel Blob PDF knowledge base. The token selects the Blob store. The prefix
# selects the folder inside that store; use __ROOT__ when PDFs are at Blob root.
# The prefix defaults to Knowledge Base/.
BLOB_READ_WRITE_TOKEN=
AI_KB_BLOB_PREFIX=Knowledge Base/

# Optional: public URL for a remote AI tactics database JSON (exposed to client,
# must keep the VITE_ prefix). If unset, the built-in tactics database is used.
VITE_AI_TACTICS_URL=

# Server port — Railway/Heroku set this automatically; only override locally.
PORT=3000
